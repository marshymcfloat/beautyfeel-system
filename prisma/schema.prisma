generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STAFF
}

enum BookingSource {
  ONLINE
  MESSENGER
  PHONE
  WALK_IN
}

enum BookingStatus {
  AWAITING_PAYMENT
  PENDING_VERIFICATION
  CONFIRMED
  COMPLETED
  NO_SHOW
  EXPIRED
  REJECTED
  CANCELLED
}

enum AllocationState {
  ACTIVE
  RELEASED
}

enum StaffingStatus {
  ASSIGNED
  FLEX_RESERVED
}

enum DepositStatus {
  UNPAID
  CLAIMED
  VERIFIED
  REJECTED
  WAIVED
  FORFEITED
}

enum SmsStatus {
  PENDING
  PROCESSING
  SENT
  RETRY
  FAILED
}

enum TrustStatus {
  NORMAL
  TRUSTED
  BLOCKED
}

enum StoreCreditStatus {
  ACTIVE
  USED
  EXPIRED
  VOIDED
}

enum SegmentCompletionStatus {
  PENDING
  COMPLETED
  NO_SHOW
}

model UserProfile {
  id                 String   @id @db.Uuid
  role               UserRole
  displayName        String   @map("display_name")
  phoneE164          String   @unique @map("phone_e164")
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  staffProfile       StaffProfile?
  auditLogs          AuditLog[]
  bookingHistory     BookingStatusHistory[]
  completedSegments BookingSegment[] @relation("SegmentCompletedBy")

  @@map("user_profiles")
}

model StaffProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  publicName    String   @map("public_name")
  internalName  String?  @map("internal_name")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)
  skills        StaffService[]
  scheduleRules StaffScheduleRule[]
  breaks        StaffBreak[]
  timeOff       StaffTimeOff[]
  segments      BookingSegment[]

  @@index([active])
  @@map("staff_profiles")
}

model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  available24Hours Boolean @default(false) @map("available_24_hours")
  services  Service[]
  flexUnits FlexCapacityUnit[]

  @@map("service_categories")
}

model FlexCapacityUnit {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  unitNumber Int      @map("unit_number")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  segments   BookingSegment[]

  @@unique([categoryId, unitNumber])
  @@index([categoryId, active])
  @@map("flex_capacity_units")
}

model Service {
  id                String   @id @default(uuid()) @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  name              String
  description       String?
  priceCentavos     Int      @map("price_centavos")
  durationMinutes   Int      @map("duration_minutes")
  bufferMinutes     Int      @default(0) @map("buffer_minutes")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  category          ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  staffSkills       StaffService[]
  bookingServices   BookingService[]

  @@index([categoryId, active])
  @@map("services")
}

model StaffService {
  staffId   String @map("staff_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_services")
}

model StaffScheduleRule {
  id              String   @id @default(uuid()) @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  weekday         Int
  startMinute     Int      @map("start_minute")
  endMinute       Int      @map("end_minute")
  effectiveFrom   DateTime @map("effective_from") @db.Date
  effectiveUntil  DateTime? @map("effective_until") @db.Date
  staff           StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday, effectiveFrom])
  @@map("staff_schedule_rules")
}

model StaffBreak {
  id          String   @id @default(uuid()) @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  weekday     Int?
  date        DateTime? @db.Date
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date, weekday])
  @@map("staff_breaks")
}

model StaffTimeOff {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt, endsAt])
  @@map("staff_time_off")
}

model BusinessSettings {
  id                       Int      @id @default(1)
  timezone                 String   @default("Asia/Manila")
  gcashNumber              String?  @map("gcash_number")
  gcashName                String?  @map("gcash_name")
  businessAddress          String?  @map("business_address")
  businessMapUrl           String?  @map("business_map_url")
  depositPercent           Int      @default(20) @map("deposit_percent")
  bookingIntervalMinutes   Int      @default(15) @map("booking_interval_minutes")
  minimumLeadMinutes       Int      @default(60) @map("minimum_lead_minutes")
  maximumAdvanceDays       Int      @default(30) @map("maximum_advance_days")
  holdDurationMinutes      Int      @default(30) @map("hold_duration_minutes")
  verificationSlaMinutes   Int      @default(60) @map("verification_sla_minutes")
  otpTrustDays             Int      @default(30) @map("otp_trust_days")
  cancellationCutoffHours  Int      @default(24) @map("cancellation_cutoff_hours")
  rescheduleNoticeHours    Int      @default(24) @map("reschedule_notice_hours")
  flexStrictCutoffHours    Int      @default(48) @map("flex_strict_cutoff_hours")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("business_settings")
}

model BusinessHoursRule {
  id          String  @id @default(uuid()) @db.Uuid
  weekday     Int
  startMinute Int     @map("start_minute")
  endMinute   Int     @map("end_minute")
  active      Boolean @default(true)

  @@index([weekday, active])
  @@map("business_hours_rules")
}

model BusinessClosure {
  id       String   @id @default(uuid()) @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  reason   String?

  @@index([startsAt, endsAt])
  @@map("business_closures")
}

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  publicCode         String        @unique @map("public_code")
  customerName       String        @map("customer_name")
  customerPhoneE164  String        @map("customer_phone_e164")
  gcashSenderName    String        @default("Unknown") @map("gcash_sender_name")
  source             BookingSource
  status             BookingStatus
  staffingStatus     StaffingStatus  @default(ASSIGNED) @map("staffing_status")
  subtotalCentavos   Int           @map("subtotal_centavos")
  depositCentavos    Int           @map("deposit_centavos")
  requestedStartsAt  DateTime      @map("requested_starts_at") @db.Timestamptz(3)
  requestedEndsAt    DateTime      @map("requested_ends_at") @db.Timestamptz(3)
  holdExpiresAt      DateTime?     @map("hold_expires_at") @db.Timestamptz(3)
  guestTokenHash     String?       @map("guest_token_hash")
  phoneVerificationId String?      @map("phone_verification_id") @db.Uuid
  policyVersion      String        @default("2026-08-01") @map("policy_version")
  policyAcceptedAt   DateTime      @default(now()) @map("policy_accepted_at") @db.Timestamptz(3)
  riskLevel          String        @default("LOW") @map("risk_level")
  riskReasons        Json?         @map("risk_reasons")
  rescheduleCount    Int           @default(0) @map("reschedule_count")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  services           BookingService[]
  segments           BookingSegment[]
  deposit            Deposit?
  statusHistory      BookingStatusHistory[]
  adminAlerts        AdminAlert[]
  phoneVerification  PhoneVerification? @relation(fields: [phoneVerificationId], references: [id], onDelete: SetNull)
  storeCredits       StoreCredit[]

  @@index([status, requestedStartsAt])
  @@index([customerPhoneE164, createdAt])
  @@index([holdExpiresAt])
  @@map("bookings")
}

model BookingService {
  id                      String @id @default(uuid()) @db.Uuid
  bookingId               String @map("booking_id") @db.Uuid
  serviceId               String @map("service_id") @db.Uuid
  serviceName             String @map("service_name")
  priceCentavos           Int    @map("price_centavos")
  durationMinutes         Int    @map("duration_minutes")
  bufferMinutes           Int    @map("buffer_minutes")
  booking                 Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service                 Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  segments                BookingSegment[]

  @@index([bookingId])
  @@map("booking_services")
}

model BookingSegment {
  id               String          @id @default(uuid()) @db.Uuid
  bookingId        String          @map("booking_id") @db.Uuid
  bookingServiceId String          @map("booking_service_id") @db.Uuid
  staffId          String?         @map("staff_id") @db.Uuid
  flexUnitId       String?         @map("flex_unit_id") @db.Uuid
  startsAt         DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime        @map("ends_at") @db.Timestamptz(3)
  blockedUntil     DateTime        @map("blocked_until") @db.Timestamptz(3)
  executionOrder   Int             @map("execution_order")
  allocationState  AllocationState @default(ACTIVE) @map("allocation_state")
  completionStatus SegmentCompletionStatus @default(PENDING) @map("completion_status")
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(3)
  completedById    String?         @map("completed_by_id") @db.Uuid
  booking          Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingService   BookingService  @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)
  staff            StaffProfile?   @relation(fields: [staffId], references: [id], onDelete: Restrict)
  flexUnit         FlexCapacityUnit? @relation(fields: [flexUnitId], references: [id], onDelete: Restrict)
  completedBy      UserProfile?    @relation("SegmentCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([bookingId, executionOrder])
  @@index([bookingServiceId])
  @@index([staffId, startsAt, blockedUntil])
  @@index([flexUnitId, startsAt, blockedUntil])
  @@map("booking_segments")
}

model AdminAlert {
  id        String    @id @default(uuid()) @db.Uuid
  eventKey  String    @unique @map("event_key")
  bookingId String?   @map("booking_id") @db.Uuid
  severity  String
  type      String    @default("GENERAL")
  message   String
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById String? @map("acknowledged_by_id") @db.Uuid
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([readAt, createdAt])
  @@map("admin_alerts")
}

model BookingStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  actorId    String?        @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor      UserProfile?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

model Deposit {
  id               String        @id @default(uuid()) @db.Uuid
  bookingId        String        @unique @map("booking_id") @db.Uuid
  status           DepositStatus
  expectedCentavos Int           @map("expected_centavos")
  claimedAt        DateTime?     @map("claimed_at") @db.Timestamptz(3)
  senderName       String?       @map("sender_name")
  paymentReference String?       @map("payment_reference")
  claimedAmountCentavos Int?     @map("claimed_amount_centavos")
  verificationDueAt DateTime?    @map("verification_due_at") @db.Timestamptz(3)
  overdueAt        DateTime?     @map("overdue_at") @db.Timestamptz(3)
  escalatedAt      DateTime?     @map("escalated_at") @db.Timestamptz(3)
  verifiedAt       DateTime?     @map("verified_at") @db.Timestamptz(3)
  ownerNote        String?       @map("owner_note")
  customerNote     String?       @map("customer_note")
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("deposits")
}

model PhoneVerification {
  id               String   @id @default(uuid()) @db.Uuid
  phoneE164        String   @map("phone_e164")
  otpHash          String?  @map("otp_hash")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)
  attemptCount     Int      @default(0) @map("attempt_count")
  resendCount      Int      @default(0) @map("resend_count")
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(3)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(3)
  trustedTokenHash String?  @map("trusted_token_hash")
  trustedUntil     DateTime? @map("trusted_until") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  bookings         Booking[]

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
  @@map("phone_verifications")
}

model CustomerTrustProfile {
  id                    String      @id @default(uuid()) @db.Uuid
  phoneE164             String      @unique @map("phone_e164")
  status                TrustStatus @default(NORMAL)
  completedCount        Int         @default(0) @map("completed_count")
  expiredHoldCount      Int         @default(0) @map("expired_hold_count")
  rejectedClaimCount    Int         @default(0) @map("rejected_claim_count")
  otpFailureCount       Int         @default(0) @map("otp_failure_count")
  blockReason           String?     @map("block_reason")
  blockedUntil          DateTime?   @map("blocked_until") @db.Timestamptz(3)
  ownerNote             String?     @map("owner_note")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, blockedUntil])
  @@map("customer_trust_profiles")
}

model StoreCredit {
  id                String            @id @default(uuid()) @db.Uuid
  customerPhoneE164 String            @map("customer_phone_e164")
  sourceBookingId   String            @map("source_booking_id") @db.Uuid
  originalCentavos  Int               @map("original_centavos")
  remainingCentavos Int               @map("remaining_centavos")
  status            StoreCreditStatus @default(ACTIVE)
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz(3)
  usedAt            DateTime?          @map("used_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sourceBooking     Booking            @relation(fields: [sourceBookingId], references: [id], onDelete: Restrict)

  @@index([customerPhoneE164, status, expiresAt])
  @@map("store_credits")
}

model PolicyVersion {
  version           String   @id
  depositPolicy     String   @map("deposit_policy")
  cancellationPolicy String  @map("cancellation_policy")
  storeCreditPolicy String   @map("store_credit_policy")
  privacyPolicy     String   @map("privacy_policy")
  reschedulePolicy  String   @map("reschedule_policy")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("policy_versions")
}

model SmsOutbox {
  id                String    @id @default(uuid()) @db.Uuid
  eventKey          String    @unique @map("event_key")
  eventType         String    @map("event_type")
  recipientE164     String    @map("recipient_e164")
  payload           Json
  status            SmsStatus @default(PENDING)
  attemptCount      Int       @default(0) @map("attempt_count")
  providerMessageId String?   @map("provider_message_id")
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  lastErrorCode     String?   @map("last_error_code")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("sms_outbox")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      UserProfile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model PublicRateLimit {
  key         String   @map("key_hash")
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(1)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("public_rate_limits")
}
